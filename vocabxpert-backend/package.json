{
  "name": "vocabxpert-backend",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @vocabxpert/db exec prisma generate --config prisma.config.ts",
    "db:migrate": "pnpm --filter @vocabxpert/db exec prisma migrate dev --config prisma.config.ts",
    "db:studio": "pnpm --filter @vocabxpert/db exec prisma studio --config prisma.config.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prisma": "7.8.0",
    "tsx": "^4.23.5"
  }
}