datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

enum TargetLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id             String  @id @default(uuid())
  email          String? @unique
  passwordHash   String?
  displayName    String   @default("Usuário")
  nativeLanguage String

  // Campos legados: manter temporariamente durante a migração.
  targetLanguage String
  level          TargetLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interests      UserInterest[]
  lists          VocabList[]
  vocabs         Vocab[]
  reviews        VocabReview[]
  progresses     VocabProgress[]
  studySessions  StudySession[]
  studyExercises StudyExercise[]
  studyAttempts  StudyAttempt[]

  learningLanguages        UserLearningLanguage[] @relation("LearningLanguages")
  activeLearningLanguageId String?
  activeLearningLanguage   UserLearningLanguage?  @relation("ActiveLearningLanguage", fields: [activeLearningLanguageId], references: [id], onDelete: SetNull)
}

model UserLearningLanguage {
  id       String      @id @default(uuid())
  userId   String
  language String
  level    TargetLevel @default(BEGINNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("LearningLanguages", fields: [userId], references: [id], onDelete: Cascade)

  activeForUsers User[] @relation("ActiveLearningLanguage")

  lists VocabList[]

  @@unique([userId, language])
  @@index([userId])
}

model Interest {
  id   String @id @default(uuid())
  name String @unique

  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model VocabList {
  id        String  @id @default(uuid())
  userId    String
  name      String
  isDefault Boolean @default(false)

  learningLanguageId String?
  learningLanguage   UserLearningLanguage? @relation(fields: [learningLanguageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabs        Vocab[]
  studySessions StudySession[]

  @@index([userId])
  @@index([learningLanguageId])
}

model Vocab {
  id             String          @id @default(uuid())
  userId         String
  listId         String
  word           String
  translation    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wordNormalized String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  list           VocabList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  examples       VocabExample[]
  notes          VocabNote[]
  reviews        VocabReview[]
  progresses     VocabProgress[]
  studyExercises StudyExercise[]

  @@unique([listId, wordNormalized])
  @@index([userId])
  @@index([listId])
}

model VocabExample {
  id      String @id @default(uuid())
  vocabId String
  text    String

  vocab Vocab @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@index([vocabId])
}

model VocabNote {
  id        String   @id @default(uuid())
  vocabId   String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vocab Vocab @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@index([vocabId])
}

enum ReviewOutcome {
  KNOWN
  UNKNOWN
}

model VocabReview {
  id        String        @id @default(uuid())
  userId    String
  vocabId   String
  outcome   ReviewOutcome
  createdAt DateTime      @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab Vocab @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([vocabId, createdAt])
}

model VocabProgress {
  id      String @id @default(uuid())
  userId  String
  vocabId String

  ease        Float @default(2.5) // fator de facilidade (SM-2-like)
  interval    Int   @default(0) // dias
  repetitions Int   @default(0)
  streak      Int   @default(0)

  lastOutcome    ReviewOutcome?
  lastReviewedAt DateTime?
  nextDueAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab Vocab @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabId])
  @@index([userId, nextDueAt])
  @@index([vocabId])
}

enum ExerciseType {
  RANDOM
  MULTIPLE_CHOICE_TRANSLATION
  CREATE_SENTENCE
  CLOZE
  FLASHCARD
  MATCH
  DICTATION
  CHOOSE_CORRECT_EXAMPLE
  WORD_ORDER
}

enum StudyScope {
  LAST_10
  ALL
  DUE
}

model StudySession {
  id           String       @id @default(uuid())
  userId       String
  listId       String
  exerciseType ExerciseType @default(RANDOM)
  scope        StudyScope   @default(DUE)
  limit        Int          @default(10)

  direction    String @default("WORD_TO_TRANSLATION") // ✅ novo
  vocabIds     Json? // ✅ novo: string[]
  currentIndex Int    @default(0) // ✅ novo

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      VocabList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  exercises StudyExercise[]

  enabledExerciseTypes Json? // string[] com ExerciseType

  @@index([userId, createdAt])
  @@index([listId, createdAt])
}

model StudyExercise {
  id        String       @id @default(uuid())
  sessionId String
  userId    String
  vocabId   String
  type      ExerciseType
  payload   Json
  createdAt DateTime     @default(now())

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab   Vocab        @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  attempts StudyAttempt[]

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([vocabId, createdAt])
}

model StudyAttempt {
  id         String @id @default(uuid())
  exerciseId String
  userId     String

  response Json
  outcome  ReviewOutcome

  // Avaliação IA
  aiScore     Float?
  aiFeedback  String?
  aiVerdict   String? // "CORRECT"/"PARTIAL"/"INCORRECT" etc
  aiModel     String?
  aiLatencyMs Int?

  createdAt DateTime @default(now())

  exercise StudyExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exerciseId, createdAt])
  @@index([userId, createdAt])
}
